# Copy this file to .env and adjust the values for your environment.
# Frontend environment configuration

# Backend API base URL (Vite exposes this via import.meta.env.VITE_API_URL)
# RECOMMENDED for Docker/nginx deployment: relative '/api'
#   - Dev: Vite proxies /api -> http://localhost:5000
#   - Production: nginx proxies /api -> backend service
VITE_API_URL=/api

# Backend Socket.IO URL for real-time features (live GPS tracking, notifications)
# Leave empty for same-origin (nginx proxies /socket.io -> backend).
# Only set an absolute URL when the frontend and backend are on different domains.
VITE_SOCKET_URL=

# ----------------------------------------------------------------------------
# ALTERNATIVE: If you deploy the frontend and backend on DIFFERENT domains
# (e.g. frontend on Vercel/Netlify and backend on Railway/Render/VPS),
# use the absolute backend URL instead and make sure CORS is configured on the
# backend (FRONTEND_URL in backend/.env must include your frontend domain).
# ----------------------------------------------------------------------------
# VITE_API_URL=https://your-backend-domain.com/api
# VITE_SOCKET_URL=https://your-backend-domain.com

# NOTE: If these are left empty or removed, the app automatically falls back to
# relative '/api' and same-origin Socket.IO, which works with the bundled
# nginx proxy (Docker) and the Vite dev proxy.

