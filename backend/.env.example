# Backend environment template.
# Copy to .env and fill in real values. .env is gitignored.

# Server
PORT=5000
NODE_ENV=production

# Frontend CORS origin (used by CORS middleware)
FRONTEND_URL=http://localhost

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=medical_supply_chain
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# AI module base URL (backend calls the Flask service)
AI_MODULE_URL=http://ai-module:8000

# Auth / JWT secrets (REPLACE in production)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Email (optional) - SMTP for notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
